diff --git a/Backend/tests/ticket-merge.check.mjs b/Backend/tests/ticket-merge.check.mjs
new file mode 100644
index 0000000..c26d8ad
--- /dev/null
+++ b/Backend/tests/ticket-merge.check.mjs
@@ -0,0 +1,78 @@
+// Doubt chat on Lambda: every container keeps its own memory copy of a ticket. Checks that
+//  1. a ticket is read from the database row, not a stale memory copy (the app saw teacher replies late or never), and
+//  2. two servers saving the same ticket at once keep BOTH new messages, in a stable order (?after=N polling relies on it).
+// Run against a throwaway database (it creates and empties doubt_tickets / ticket_blobs):
+//   DATABASE_URL=postgres://... node tests/ticket-merge.check.mjs
+import assert from "node:assert/strict";
+import { build } from "esbuild";
+import { rm } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+if (!process.env.DATABASE_URL) throw new Error("Set DATABASE_URL to a throwaway database");
+process.env.AWS_LAMBDA_FUNCTION_NAME ||= "check"; // like Lambda: no warm-up, no seeding
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+// The real tickets.ts (and @workspace/db, which is TypeScript) bundled; npm packages stay external
+const out = path.resolve(here, "../node_modules/.cache/ticket-check.mjs");
+await build({
+  stdin: { contents: 'export * from "./src/routes/tickets.ts"; export { pool } from "@workspace/db";', resolveDir: path.resolve(here, ".."), loader: "ts" },
+  bundle: true,
+  platform: "node",
+  format: "esm",
+  outfile: out,
+  external: ["express", "pg", "drizzle-orm", "socket.io", "pino", "pino-http", "zod", "firebase-admin", "redis", "dotenv"],
+  logLevel: "error",
+});
+const { persistTicket, findTicketLight, ticketsStore, pool } = await import(pathToFileURL(out).href);
+
+await pool.query(`CREATE TABLE IF NOT EXISTS doubt_tickets (
+  id VARCHAR(64) PRIMARY KEY, ticket_number VARCHAR(32) NOT NULL UNIQUE, status VARCHAR(32) NOT NULL, data JSONB NOT NULL,
+  submitted_at TIMESTAMPTZ NOT NULL DEFAULT now(), created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now())`);
+await pool.query("CREATE TABLE IF NOT EXISTS ticket_blobs (id TEXT PRIMARY KEY, content TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT now())");
+await pool.query("TRUNCATE doubt_tickets, ticket_blobs");
+
+const msg = (id, sender) => ({ id, sender, senderName: sender, text: id, time: "10:00" });
+const base = {
+  id: "t-check",
+  ticketNumber: "TKT-9001",
+  status: "queue",
+  submittedAt: new Date().toISOString(),
+  studentInfo: { email: "s@example.com" },
+  messages: [msg("m1", "student")],
+};
+const copy = () => structuredClone(base);
+const savedIds = async () => (await pool.query("SELECT data FROM doubt_tickets WHERE id = $1", [base.id])).rows[0].data.messages.map((m) => m.id);
+
+await persistTicket(copy());
+
+// 1. Another container adds a reply straight to the row; this process' memory copy doesn't have it
+const other = copy();
+other.messages.push(msg("ta1", "ta"));
+await pool.query("UPDATE doubt_tickets SET data = $2 WHERE id = $1", [base.id, JSON.stringify(other)]);
+assert.equal(ticketsStore.find((t) => t.id === base.id).messages.length, 1, "memory copy is stale on purpose");
+assert.deepEqual((await findTicketLight(base.id)).messages.map((m) => m.id), ["m1", "ta1"], "read must come from the row");
+assert.equal((await findTicketLight("tkt-9001")).id, base.id, "ticket number lookup, any case");
+
+// 2. Two servers, each holding a copy without the other's new message, save at the same moment
+const a = copy();
+a.messages.push(msg("st2", "student"));
+const b = copy();
+b.messages.push(msg("ta2", "ta"));
+b.status = "in_progress";
+await Promise.all([persistTicket(a), persistTicket(b)]);
+const ids = await savedIds();
+assert.deepEqual(ids.slice(0, 2), ["m1", "ta1"], "saved messages keep their place");
+assert.deepEqual([...ids.slice(2)].sort(), ["st2", "ta2"], "both concurrent replies are kept");
+
+// Saving an old copy again (retry, or a status change) adds nothing and moves nothing
+await persistTicket(copy());
+assert.deepEqual(await savedIds(), ids);
+const row = (await pool.query("SELECT status FROM doubt_tickets WHERE id = $1", [base.id])).rows[0];
+assert.equal(row.status, "queue", "status is still last writer wins");
+
+await pool.query("TRUNCATE doubt_tickets, ticket_blobs");
+await pool.end();
+await rm(out, { force: true });
+console.log("ticket-merge check passed");
+process.exit(0); // the db module keeps a keep-alive timer

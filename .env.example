# ==============================================================================
# EduRain Web App Frontend Environment Variables (.env.example)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put private keys, database URLs, or backend secrets here.
# ==============================================================================

# Backend API Endpoint
VITE_API_URL=http://localhost:5000

# CMS Portal URL
VITE_CMS_URL=http://localhost:5174

# MSG91 OTP Widget Configuration
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# Firebase Client Web Configuration (Public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ==============================================================================
# EduRain Backend Server Environment Variables (.env.example)
# Keep actual values strictly in .env (never commit .env to version control)
# ==============================================================================

# Server Port
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=no-verify
# DB connection wait before giving up (default 10000; Lambda uses 5000). Slow internet on a local run: 20000
# DB_CONNECT_TIMEOUT_MS=10000
# Longest a single query may run (default 30000)
# DB_STATEMENT_TIMEOUT_MS=30000
# Local run against the LIVE database: keep the payment sweeper off so it never settles real orders from your PC
# PAYMENT_JOBS=off
# Newest doubt tickets kept in memory per server (older ones are read from the database when opened)
# TICKETS_MEMORY_LIMIT=300

# Public API Base URL
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=*

# AWS S3 Storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_FREE_ENROLLMENT=false

# Bunny.net Video Stream CDN
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# MSG91 SMS & OTP Service
MSG91_AUTH_KEY=

# Monitoring & Slack Error Alarms
ADMIN_ALERT_EMAIL=
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Redis Multi-Tier Cache (Optional, in-memory RAM fallback if empty)
REDIS_URL=
